{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls*)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(find*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(file*)",
      "Bash(stat*)",
      "Bash(echo*)",
      "Bash(pwd*)",
      "Bash(which*)",
      "Bash(type*)",
      "Bash(man*)",
      "Bash(less*)",
      "Bash(more*)",
      "Bash(sort*)",
      "Bash(uniq*)",
      "Bash(cut*)",
      "Bash(awk*)",
      "Bash(sed*)",
      "Bash(tr*)",
      "Bash(diff*)",
      "Bash(tree*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(git shortlog*)",
      "Bash(git describe*)",
      "Bash(git rev-parse*)",
      "Bash(git remote*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "model": "opus",
  "env": {
    "PONYTAIL_SUBAGENT_MATCHER": "^(?!(Explore|Plan)$)"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "impeccable@impeccable": true,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true,
    "agent-skills@addy-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.1.0"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills",
        "ref": "0.6.12"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "advisorModel": "opus",
  "theme": "custom:catppuccin-macchiato",
  "syncClaudeAiSkills": false
}
