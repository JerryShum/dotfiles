// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "Git Commit": {
      "format_on_save": "on"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "agent": {
      "default_model": {
        "provider": "ollama",
        "model": "gemma4:e4b-mlx",
        "enable_thinking": true
      },
      "commit_message_model": {
        "provider": "ollama",
        "model": "qwen2.5-coder:3b"
      },
      // Project rules (CLAUDE.md, AGENTS.md, .rules) default to ON and added ~1400
      // tokens of prompt eval per commit. Measured on llama3.2:3b: 5.16s -> 0.40s.
      "commit_message_include_project_rules": false,
      "commit_message_instructions": "Write the commit message in Conventional Commits format: one subject line of the form type(scope): summary, under 72 characters, lowercase after the colon, no trailing period. Valid types: feat, fix, docs, refactor, test, chore, perf, build, ci. Respond with the subject line only.",
      "favorite_models": [],
      "model_parameters": []
    },
  "text_rendering_mode": "platform_default",
  "edit_predictions": {
    "mode": "subtle",
    "codestral": {
      "model": "codestral-latest"
    },
    "ollama": {
      "api_url": "http://localhost:11434",
      "model": "qwen2.5-coder:3b",
    },
    "provider": "zed",
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Light",
    "dark": "Colored Zed Icons Theme Dark",
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": true,
    "anthropic_retention": false,
  },
  "terminal": {
    "env": {},
    "font_family": "Fira Code",
  },
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "always",
  },
  "autosave": "on_focus_change",
  "buffer_font_family": "Fira Code",
  "linked_edits": true,
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "ui_font_size": 18.0,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Macchiato",
  },
  "semantic_tokens": "off",
  "theme_overrides": {
    "Catppuccin Espresso (Blur)": {
      "syntax": {
        "constant.comment.todo": {
          "color": "#FF8C00",
          "background_color": "#2B1700",
          "font_weight": 600,
        },
        "constant.comment.wip": {
          "color": "#FF8C00",
          "background_color": "#2B1700",
          "font_weight": 600,
        },
        "string.comment.info": {
          "color": "#0acaff",
          "background_color": "#001B2B",
          "font_weight": 600,
        },
        "string.comment.note": {
          "color": "#0acaff",
          "background_color": "#001B2B",
          "font_weight": 600,
        },
        "property.comment.error": {
          "color": "#FF453A",
          "background_color": "#2B0A00",
          "font_weight": 600,
        },
        "property.comment.fixme": {
          "color": "#FF453A",
          "background_color": "#2B0A00",
          "font_weight": 600,
        },
        "keyword.comment.hack": {
          "color": "#FFD60A",
          "background_color": "#272100",
          "font_weight": 600,
        },
        "keyword.comment.warning": {
          "color": "#FF9F0A",
          "background_color": "#271B00",
          "font_weight": 600,
        },
      },
    },
    "Catppuccin Macchiato": {
      "syntax": {
        "constant.comment.todo": {
          "color": "#FF8C00",
          "background_color": "#2B1700",
          "font_weight": 600,
        },
        "constant.comment.wip": {
          "color": "#FF8C00",
          "background_color": "#2B1700",
          "font_weight": 600,
        },
        "string.comment.info": {
          "color": "#0acaff",
          "background_color": "#001B2B",
          "font_weight": 600,
        },
        "string.comment.note": {
          "color": "#0acaff",
          "background_color": "#001B2B",
          "font_weight": 600,
        },
        "property.comment.error": {
          "color": "#FF453A",
          "background_color": "#2B0A00",
          "font_weight": 600,
        },
        "property.comment.fixme": {
          "color": "#FF453A",
          "background_color": "#2B0A00",
          "font_weight": 600,
        },
        "keyword.comment.hack": {
          "color": "#FFD60A",
          "background_color": "#272100",
          "font_weight": 600,
        },
        "keyword.comment.warning": {
          "color": "#FF9F0A",
          "background_color": "#271B00",
          "font_weight": 600,
        },
      },
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": [
          "class",
          "className",
          "headerClassName",
          "contentContainerClassName",
          "columnWrapperClassName",
          "endFillColorClassName",
          "imageClassName",
          "tintColorClassName",
          "ios_backgroundColorClassName",
          "thumbColorClassName",
          "trackColorOnClassName",
          "trackColorOffClassName",
          "selectionColorClassName",
          "cursorColorClassName",
          "underlineColorAndroidClassName",
          "placeholderTextColorClassName",
          "selectionHandleColorClassName",
          "colorsClassName",
          "progressBackgroundColorClassName",
          "titleColorClassName",
          "underlayColorClassName",
          "colorClassName",
          "drawerBackgroundColorClassName",
          "statusBarBackgroundColorClassName",
          "backdropColorClassName",
          "backgroundColorClassName",
          "ListFooterComponentClassName",
          "ListHeaderComponentClassName"
        ],
        "classFunctions": ["useResolveClassNames"],
      },
    },
  },
}
